---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
const action = site.formspreeId ? `https://formspree.io/f/${site.formspreeId}` : `mailto:${site.email}`;
const field = 'mt-1 w-full rounded border border-line bg-card px-3 py-2 text-fg';
---
<Base title="Contact" description="Get in touch about roles, projects, or collaboration.">
  <div class="mx-auto max-w-2xl">
    <h1 class="font-serif text-4xl font-bold">Contact</h1>
    <p class="mt-3 text-muted">The fastest way to reach me is email. I read every message.</p>
    <ul class="mt-6 space-y-1">
      {site.socials.map((s) => <li><a href={s.url} rel="me noopener" class="text-accent hover:underline">{s.label}</a></li>)}
    </ul>
    <form action={action} method={site.formspreeId ? 'POST' : 'GET'} enctype={site.formspreeId ? undefined : 'text/plain'} class="mt-10 space-y-5">
      <div><label for="name" class="text-sm font-medium">Your name</label><input id="name" name="name" required autocomplete="name" class={field} /></div>
      <div><label for="email" class="text-sm font-medium">Your email</label><input id="email" name="email" type="email" required autocomplete="email" class={field} /></div>
      <div><label for="message" class="text-sm font-medium">Message</label><textarea id="message" name="message" rows="6" required class={field}></textarea></div>
      <button type="submit" class="rounded bg-accent px-5 py-2.5 text-sm font-medium text-bg hover:opacity-90">Send message</button>
    </form>
  </div>
</Base>
