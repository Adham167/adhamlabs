---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NoteRow from '../components/NoteRow.astro';
import { site } from '../data/site';

const projects = (await getCollection('projects', (p) => !p.data.draft))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const notes = (await getCollection('learning', (n) => !n.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
---
<Base>
  <section class="max-w-3xl">
    <h1 class="font-serif text-5xl font-bold leading-[1.05] tracking-tight sm:text-7xl">{site.name}</h1>
    <p class="mt-3 text-lg text-muted">{site.role}</p>
    <p class="mt-8 max-w-prose text-xl leading-relaxed">{site.tagline}</p>
    <p class="mt-4 max-w-prose leading-relaxed text-muted">{site.bio}</p>
    <ul class="mt-8 flex flex-wrap gap-3">
      {site.socials.map((s) => (
        <li><a href={s.url} rel="me noopener" class="inline-block rounded border border-line px-4 py-2 text-sm hover:border-accent hover:text-accent">{s.label}</a></li>
      ))}
    </ul>
  </section>

  <section class="mt-20">
    <h2 class="font-serif text-2xl font-semibold">Skills</h2>
    <dl class="mt-5 grid gap-6 sm:grid-cols-3">
      {site.skills.map((g) => (
        <div><dt class="font-medium">{g.group}</dt><dd class="mt-1 text-sm leading-relaxed text-muted">{g.items.join(', ')}</dd></div>
      ))}
    </dl>
  </section>

  <section class="mt-20">
    <div class="flex items-baseline justify-between"><h2 class="font-serif text-2xl font-semibold">Projects</h2><a href="/projects" class="text-sm text-accent hover:underline">All projects</a></div>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{projects.map((p) => <div class="relative"><ProjectCard project={p} /></div>)}</div>
  </section>

  <section class="mt-20">
    <div class="flex items-baseline justify-between"><h2 class="font-serif text-2xl font-semibold">Latest from the archive</h2><a href="/learning" class="text-sm text-accent hover:underline">Full archive</a></div>
    <ul class="mt-4 border-t border-line">{notes.map((n) => <NoteRow note={n} />)}</ul>
  </section>
</Base>
