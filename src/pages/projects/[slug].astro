---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { toEmbed } from '../../lib/video';

export async function getStaticPaths() {
  const items = await getCollection('projects', (p) => !p.data.draft);
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---
<Base title={d.title} description={d.description} image={d.featuredImage}>
  <article class="mx-auto max-w-3xl">
    <a href="/projects" class="text-sm text-muted hover:text-fg">Back to projects</a>
    <h1 class="mt-4 font-serif text-4xl font-bold leading-tight">{d.title}</h1>
    <p class="mt-3 text-lg text-muted">{d.description}</p>
    <dl class="mt-6 grid gap-4 border-y border-line py-5 text-sm sm:grid-cols-3">
      <div><dt class="text-muted">Role</dt><dd class="font-medium">{d.role}</dd></div>
      <div><dt class="text-muted">Date</dt><dd class="font-medium">{d.date.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}</dd></div>
      <div><dt class="text-muted">Stack</dt><dd class="font-medium">{d.techStack.join(', ')}</dd></div>
    </dl>
    <p class="mt-5 flex flex-wrap gap-3 text-sm">
      {d.githubUrl && <a href={d.githubUrl} class="rounded border border-line px-4 py-2 hover:border-accent hover:text-accent" rel="noopener">View source on GitHub</a>}
      {d.demoUrl && <a href={d.demoUrl} class="rounded border border-line px-4 py-2 hover:border-accent hover:text-accent" rel="noopener">Open live demo</a>}
    </p>
    {d.featuredImage && <img src={d.featuredImage} alt={`${d.title} screenshot`} width="1200" height="675" class="mt-8 w-full rounded-lg border border-line" />}
    {d.demoVideo && (
      <div class="mt-8 aspect-video overflow-hidden rounded-lg border border-line">
        <iframe src={toEmbed(d.demoVideo)} title={`${d.title} demo video`} loading="lazy" class="h-full w-full" allowfullscreen></iframe>
      </div>
    )}
    {d.architectureImage && (
      <figure class="mt-8"><img src={d.architectureImage} alt={`${d.title} architecture diagram`} loading="lazy" class="w-full rounded-lg border border-line bg-white" /><figcaption class="mt-2 text-sm text-muted">Architecture diagram</figcaption></figure>
    )}
    <div class="prose prose-neutral mt-10 max-w-none dark:prose-invert"><Content /></div>
  </article>
</Base>
